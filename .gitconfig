[core]
  editor = vim
  autocrlf = input
  whitespace = trailing-space,space-before-tab,indent-with-non-tab
  excludesfile = ~/.gitignore_global
[color]
  ui = true
[user]
  name = issuy
  email = akito.ew@gmail.com
[init]
  defaultBranch = main
[diff]
  tool = vimdiff
[difftool]
  prompt = false
[transfer]
	fsckObjects = true
# ~/.gitconfig.local: 公開しない・マシンごとの設定（コミット署名の gpg.format / user.signingkey / commit.gpgsign / gpg.ssh.allowedSignersFile）
[include]
	path = ~/.gitconfig.local
